         "metadata": {},
         "outputs": [],
         "source": [
            "# Normalize\n",
            "X_train = X_train / 255.0\n",
            "X_test = X_test / 255.0"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 6,
         "id": "da736325",
         "metadata": {},
         "outputs": [
            {
               "name": "stdout",
               "output_type": "stream",
               "text": [
                  "After variance filtering: (60000, 623)\n"
               ]
            }
         ],
         "source": [
            "def compute_pixel_variance(X):\n",
            "    mean = np.mean(X, axis=0)\n",
            "    return np.mean((X - mean) ** 2, axis=0)\n",
            "\n",
            "def variance_threshold(X, threshold=1e-4):\n",
            "    variances = compute_pixel_variance(X)\n",
            "    mask = variances > threshold\n",
            "    return X[:, mask], mask\n",
            "\n",
            "X_train_clean, mask = variance_threshold(X_train)\n",
            "X_test_clean = X_test[:, mask]\n",
            "\n",
            "print(\"After variance filtering:\", X_train_clean.shape)\n"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 7,
         "id": "a2dd60b5",
         "metadata": {},
         "outputs": [],
         "source": [
            "import numpy as np\n",
            "from skimage.feature import hog\n",
            "\n",
            "def extract_hog_features(X):\n",
            "    features = []\n",
            "\n",
            "    for img in X:\n",
            "        img_2d = img.reshape(28, 28)\n",
            "\n",
            "        hog_features = hog(\n",
            "            img_2d,\n",
            "            orientations=9,\n",
            "            pixels_per_cell=(4, 4),\n",
            "            cells_per_block=(2, 2),\n",
            "            block_norm='L2-Hys',\n",
            "            feature_vector=True\n",
            "        )\n",
            "\n",
            "        features.append(hog_features)\n",
            "\n",
            "    return np.array(features)"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 8,
         "id": "c562021f",
         "metadata": {},
         "outputs": [],
         "source": [
            "X_train_HOG = extract_hog_features(X_train)\n",
            "X_test_HOG = extract_hog_features(X_test)"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 9,
         "id": "1f77692e",
         "metadata": {},
         "outputs": [],
         "source": [
            "pca = PCA(n_components=50)  \n",
            "\n",
            "X_train_hog_pca = pca.fit_transform(X_train_HOG)\n",
            "X_test_hog_pca = pca.transform(X_test_HOG)"
         ]
      },
